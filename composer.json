{
  "name": "tabsl/tabslfeedback",
  "description": "Feedback-Formular für Backend und Frontend mit KI-Aufbereitung und Ticket-Anlage in GitLab, weclapp oder Jira Cloud.",
  "type": "oxideshop-module",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/tabsl/tabslFeedback",
  "keywords": [
    "oxid",
    "modules",
    "eShop",
    "feedback",
    "gitlab",
    "weclapp",
    "jira",
    "openai",
    "anthropic"
  ],
  "authors": [
    {
      "name": "Tobias Merkl",
      "homepage": "https://oxid-module.eu"
    }
  ],
  "require": {
    "php": "^8.0",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-fileinfo": "*"
  },
  "conflict": {
    "oxid-esales/oxideshop-ce": "<7.0"
  },
  "autoload": {
    "psr-4": {
      "Tabsl\\Feedback\\": "./"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-b-7.x": "2.x-dev"
    }
  }
}
